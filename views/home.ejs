<!DOCTYPE html>
<html>
<head>
    <title>Library Management System</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, sans-serif;
        }

        body{
            background:#f4f6f9;
        }

        .container{
            width:80%;
            margin:auto;
        }

        .header{
            text-align:center;
            background:#2c3e50;
            color:white;
            padding:30px;
            border-radius:10px;
            margin-top:20px;
        }

        .header p{
            margin-top:10px;
        }

        nav{
            margin-top:20px;
        }

        nav a{
            text-decoration:none;
            color:white;
            background:#3498db;
            padding:10px 20px;
            border-radius:5px;
            margin:5px;
            display:inline-block;
        }

        nav a:hover{
            background:#2980b9;
        }

        .features{
            background:white;
            margin-top:30px;
            padding:20px;
            border-radius:10px;
            box-shadow:0px 0px 10px rgba(0,0,0,0.1);
        }

        .features h2{
            text-align:center;
            margin-bottom:20px;
            color:#2c3e50;
        }

        .features ul{
            list-style:none;
        }

        .features li{
            padding:12px;
            margin:10px 0;
            background:#ecf0f1;
            border-left:5px solid #3498db;
            border-radius:5px;
        }

        .footer{
            text-align:center;
            margin-top:30px;
            padding:15px;
            color:#555;
        }

    </style>
</head>

<body>

<div class="container">

    <div class="header">

        <h1>📚 Library Management System 📚</h1>

        <p>
            Welcome to the Library Management System.
            Manage books, issue books, return books and track records easily.
        </p>

        <nav>
            <a href="/">🏠Home</a>
            <a href="/register">®️Register</a> 
            <a href="/login">🔐Login</a>
            <a href="/books">📙Books Available</a>
            <a href="/issuedBooks">📙Issued Books</a>


        </nav>

    </div>

    <div class="features">

        <h2>Features</h2>

        <ul>
            <li>👤 User Registration</li>
            <li>🔑 User Login</li>
            <li>📖 Add Books</li>
            <li>📚 View Books</li>
            <li>📤 Issue Books</li>
            <li>📥 Return Books</li>
            <li>💰 Fine Calculation</li>
        </ul>

    </div>

    <div class="footer">
        <p>Library Management System | MERN Stack Project</p>
    </div>

</div>

</body>
</html>