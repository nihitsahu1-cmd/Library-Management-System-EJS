<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">
                📚 Library Management System
            </a>

            <div class="d-flex gap-2">

                <a href="/" class="btn btn-warning">
                    🏠 Home
                </a>

                <a href="/login" class="btn btn-success">
                    🔐 Login
                </a>

                <a href="/logout" class="btn btn-danger">
                    🚪 Logout
                </a>

            </div>

        </div>
    </nav>

    <div class="container py-5">

        <h2 class="text-center text-primary fw-bold mb-5">
            👨‍🎓Admin Dashboard
        </h2>


        <center>
    <img 
        src="/uploads/<%= user.photo %>"
        class="rounded-circle shadow"
        width="120"
        height="120"
        style="object-fit:cover;">

    <h4 class="mt-3"><%= user.name %></h4>
</center>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h1>📚</h1>
                        <h5 class="card-title">Add Books</h5>
                        <p class="card-text">To Add Book.</p>
                        <a href="/addBook" class="btn btn-primary w-100">Open</a>
                    </div>
                </div>
            </div>


            <div class="col-md-4">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h1>📖</h1>
                        <h5 class="card-title">View Book</h5>
                        <p class="card-text"> Availables Book</p>
                        <a href="/books" class="btn btn-success w-100">Open</a>
                    </div>
                </div>
            </div>


             <div class="col-md-4">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h1>📚</h1>
                        <h5 class="card-title">Issued Books </h5>
                        <p class="card-text">To Check Data Of ISsued Books </p>
                        <a href="/issuedBooks" class="btn btn-primary w-100">Open</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h1>📑</h1>
                        <h5 class="card-title">View Fines</h5>
                        <p class="card-text">To See All Students Fine.</p>
                        <a href="/fineLists" class="btn btn-info text-white w-100">Open</a>
                    </div>
                </div>
            </div>

<div class="col-md-4">
    <div class="card shadow h-100 text-center">
        <div class="card-body">
            <h1>📚</h1>
            <h5 class="card-title">Update Book</h5>
            <p class="card-text">Select a book to update.</p>
            <a href="/books" class="btn btn-warning w-100">
                Update Book
            </a>
        </div>
    </div>
</div>



            <div class="col-md-4">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h1>🚪</h1>
                        <h5 class="card-title">Logout</h5>
                        <p class="card-text">Sign out from your account.</p>
                        <a href="/logout" class="btn btn-danger w-100">Logout</a>
                    </div>
                </div>
            </div>

        </div>

    </div>




    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>