<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
    <div class="container">

        <!-- Logo -->
        <a class="navbar-brand fw-bold" href="/">
            📚 Library Management System
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menu -->
        <div class="collapse navbar-collapse justify-content-end" id="navbarMenu">

            <div class="d-flex gap-2">

                <a href="/" class="btn btn-warning">
                    🏠 Home
                </a>

                <a href="/login" class="btn btn-success">
                    🔐 Login
                </a>
                <a href="/Register" class="btn btn-warning">
                    ®️Register
                </a>

                <a href="/logout" class="btn btn-danger">
                    🚪 Logout
                </a>

            </div>

        </div>

    </div>
</nav>
    <!-- Dashboard -->
    <div class="container py-5">

        <h2 class="text-center text-primary fw-bold mb-5">
            🎓 Student Dashboard
        </h2>
        
<center>
    
    <img 
src="/uploads/<%= user.photo %>"
class="rounded-circle shadow"
width="120"
height="120"
style="object-fit:cover;">  
<br>
<a href="EditImage"> Edit Image </a>

</center>
<br> 



        <div class="alert alert-success text-center">
        Welcome <strong> <%= user.name %></strong> 👋 <br>
        Email: <%= user.email %>
         </div>



<div class="row g-4 justify-content-center">

    <!-- View Books -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card shadow h-100">
            <div class="card-body d-flex flex-column text-center">

                <h1>📚</h1>

                <h5 class="card-title">View All Books</h5>

                <p class="card-text">
                    Browse all available books.
                </p>

                <p class="fw-bold">
                    Total Books:
                    <span class="badge bg-primary">
                        <%= totalBooks %>
                    </span>
                </p>

                <a href="/studentBooks" class="btn btn-primary w-100 mt-auto">
                    Open
                </a>

            </div>
        </div>
    </div>

    <!-- Issued Books -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card shadow h-100">
            <div class="card-body d-flex flex-column text-center">

                <h1>📖</h1>

                <h5 class="card-title">Issued Books</h5>

                <p class="card-text">
                    View your issued books.
                </p>

                <p class="fw-bold">
                    Total Issued:
                    <span class="badge bg-success">
                        <%= issueBooks %>
                    </span>
                </p>

                <a href="/StudentIssuebooks" class="btn btn-success w-100 mt-auto">
                    Open
                </a>

            </div>
        </div>
    </div>

    <!-- Fine -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card shadow h-100">
            <div class="card-body d-flex flex-column text-center">

                <h1>💱</h1>

                <h5 class="card-title">History</h5>

                <p class="card-text">
                    History Of Books 
                </p>

                <p class="fw-bold">
                    Check History Of Your Books ...
                </p>

                <a href="/History" class="btn btn-secondary w-100 mt-auto">
                    Open
                </a>

            </div>
        </div>
    </div>

    <!-- Logout -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card shadow h-100">
            <div class="card-body d-flex flex-column text-center">

                <h1>🚪</h1>

                <h5 class="card-title">Logout</h5>

                <p class="card-text">
                    Sign out from your account.
                </p>

                <a href="/logout" class="btn btn-danger w-100 mt-auto">
                    Logout
                </a>

            </div>
        </div>
    </div>

</div>        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>