<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light d-flex flex-column min-vh-100">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container">

            <a class="navbar-brand fw-bold" href="/">
                📚 Library Management System
            </a>

            <div>
                <a href="/login" class="btn btn-light me-2">
                    Login
                </a>

                <a href="/register" class="btn btn-outline-light">
                    Register
                </a>
            </div>

        </div>
    </nav>


    <!-- Hero Section -->
    <div class="container flex-grow-1 d-flex align-items-center py-5">

        <div class="row align-items-center w-100">


            <!-- Left Section -->
            <div class="col-lg-6 text-center text-lg-start">

                <h1 class="display-4 fw-bold text-primary">
                    Welcome to <br>
                    Library Management System
                </h1>


                <p class="lead text-muted mt-3">
                    A smart platform to manage books, students,
                    issue records, returns and fines efficiently.
                </p>


                <p class="text-secondary">
                    Our system provides separate facilities for
                    <strong>Admin</strong> and <strong>Students</strong>.
                </p>


                <div class="mt-4">

                    <a href="/login" class="btn btn-primary btn-lg me-3 px-4">
                        Login
                    </a>


                    <a href="/register" class="btn btn-outline-primary btn-lg px-4">
                        Register
                    </a>

                </div>

            </div>



            <!-- Right Section -->
            <div class="col-lg-6 text-center mt-5 mt-lg-0">


                <div class="card shadow-lg border-0">

                    <div class="card-body p-5">


                        <h2 class="text-primary mb-4">
                            📚 Library Features
                        </h2>



                        <div class="row g-3">


                            <!-- Available Books -->
                            <div class="col-6">

                                <div class="border rounded p-3 bg-light shadow-sm">

                                    <h1>📖</h1>

                                    <h6>
                                        Available Books
                                    </h6>

                                    <small class="text-muted">
                                        View all library books
                                    </small>

                                </div>

                            </div>



                            <!-- Issue Books -->
                            <div class="col-6">

                                <div class="border rounded p-3 bg-light shadow-sm">

                                    <h1>📥</h1>

                                    <h6>
                                        Issue Books
                                    </h6>

                                    <small class="text-muted">
                                        Borrow books easily
                                    </small>

                                </div>

                            </div>



                            <!-- Return Books -->
                            <div class="col-6">

                                <div class="border rounded p-3 bg-light shadow-sm">

                                    <h1>📤</h1>

                                    <h6>
                                        Return Books
                                    </h6>

                                    <small class="text-muted">
                                        Return before due date
                                    </small>

                                </div>

                            </div>



                            <!-- Fine -->
                            <div class="col-6">

                                <div class="border rounded p-3 bg-light shadow-sm">

                                    <h1>💰</h1>

                                    <h6>
                                        Fine Details
                                    </h6>

                                    <small class="text-muted">
                                        Check penalty records
                                    </small>

                                </div>

                            </div>




                            <!-- Admin Update -->
                            <div class="col-6">

                                <div class="border rounded p-3 bg-light shadow-sm">

                                    <h1>✏️</h1>

                                    <h6>
                                        Update Books
                                    </h6>

                                    <small class="text-muted">
                                        Admin management
                                    </small>

                                </div>

                            </div>




                            <!-- Students -->
                            <div class="col-6">

                                <div class="border rounded p-3 bg-light shadow-sm">

                                    <h1>👨‍🎓</h1>

                                    <h6>
                                        Students
                                    </h6>

                                    <small class="text-muted">
                                        Manage users
                                    </small>

                                </div>

                            </div>



                        </div>


                    </div>

                </div>


            </div>


        </div>


    </div>




    <!-- Library Rules -->

    <div class="container mb-4">

        <div class="alert alert-warning text-center shadow-sm">


            <h5>
                📢 Library Rules
            </h5>


            <p class="mb-1">
                Please return books within
                <strong>14 days</strong>.
            </p>


            <p class="mb-0">
                After due date,
                <strong>₹5 per day</strong>
                fine will be charged.
            </p>


        </div>

    </div>





    <!-- Footer -->

    <footer class="bg-dark text-white text-center py-3 mt-auto">

        <p class="mb-0">
            © 2026 Library Management System |
            MERN Stack Project
        </p>

    </footer>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>